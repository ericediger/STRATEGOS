# STRATEGOS Research Engine — copy to research/.env and fill in your keys
# Shared by the research engine, EDR and the citation verifier.

# Research provider: Google Gemini Deep Research
GEMINI_API_KEY=your-gemini-api-key

# Research provider: EDR (requires both DeepSeek and Tavily)
DEEPSEEK_API_KEY=your-deepseek-api-key
TAVILY_API_KEY=your-tavily-api-key

# Research provider + citation verification: Kimi (Moonshot AI)
KIMI_API_KEY=your-kimi-api-key

# Optional overrides (defaults shown)
PORT=4456
EDR_URL=http://localhost:9001
