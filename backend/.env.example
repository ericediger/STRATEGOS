# STRATEGOS Backend — copy to backend/.env and fill in your keys

# Required: Claude (chat collaboration, brief synthesis, artifact generation, document export)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Required: OpenAI (strategic analysis)
OPENAI_API_KEY=your-openai-api-key

# Optional overrides (defaults shown)
PORT=4000
DATABASE_PATH=./data/strategos.db
PROJECTS_ROOT=./projects
RESEARCH_ENGINE_URL=http://localhost:4456
VERIFIER_URL=http://localhost:9002
